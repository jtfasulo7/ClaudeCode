# Environment
# NOTE: bare ".env" only matches a file literally named .env — it does NOT
# match .env.vercel, which is how that file ended up tracked. Use .env* .
.env
.env*
!.env.example
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# Dependencies
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Google API credentials
credentials.json
client_secret_*.json
token.json
scripts/google-auth.js
scripts/send-email.js

# IDE
.vscode/
.idea/
*.suo
*.user

.vercel

# MCP config (contains API keys)
.mcp.json

.env*.local
