# ---- GoHighLevel (server-side only; never exposed to the browser) ----------
# Private Integration token or Location API key for the Montara Forge sub-account.
GHL_API_TOKEN=
# The sub-account (location) ID.
GHL_LOCATION_ID=

# ---- Meta Pixel (public; read in the browser) ------------------------------
# Set when the Montara Forge Meta Pixel is created. Leave empty to render no
# pixel code at all — every tracking call becomes a safe no-op.
NEXT_PUBLIC_META_PIXEL_ID=

# ---- Optional dev helpers --------------------------------------------------
# Log every postMessage from the GHL booking iframe to the console, to verify
# the booking-confirmation message shape (see components/BookingCalendar.tsx).
NEXT_PUBLIC_DEBUG_GHL_MESSAGES=
